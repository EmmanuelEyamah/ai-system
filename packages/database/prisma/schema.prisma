generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(auto()) @map("_id") @db.ObjectId
  name             String             @default("Default User")
  createdAt        DateTime           @default(now())
  chats            Chat[]
  researchSessions ResearchSession[]
  ideaCritiques    IdeaCritique[]
  trendSessions    TrendSession[]
  folders          Folder[]
  contentSessions     ContentSession[]
  strategistSessions  StrategistSession[]
  coachSessions       CoachSession[]
}

model Chat {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  userId          String            @db.ObjectId
  title           String            @default("New Chat")
  taskType        String?
  status          String            @default("active")
  starred         Boolean           @default(false)
  analysisModel   String            @default("claude-sonnet-4.6")
  generationModel String            @default("claude-sonnet-4.6")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id])
  messages        Message[]
  prompts         GeneratedPrompt[]
}

model Message {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  chatId      String            @db.ObjectId
  role        String
  content     String
  metadata    Json?
  createdAt   DateTime          @default(now())
  chat        Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  prompts     GeneratedPrompt[]
  attachments Attachment[]
}

model Attachment {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  messageId     String?  @db.ObjectId
  chatId        String   @db.ObjectId
  fileName      String
  fileType      String
  mimeType      String
  fileSize      Int
  storagePath   String
  extractedText String?
  createdAt     DateTime @default(now())
  message       Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model GeneratedPrompt {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  chatId      String   @db.ObjectId
  messageId   String?  @db.ObjectId
  variant     String
  modelTarget String
  content     String
  score       Float?
  explanation String?
  createdAt   DateTime @default(now())
  chat        Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  message     Message? @relation(fields: [messageId], references: [id])
}

model ResearchSession {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  userId        String            @db.ObjectId
  title         String            @default("New Research")
  query         String
  status        String            @default("pending")
  starred       Boolean           @default(false)
  researchModel String            @default("claude-sonnet-4.6")
  reportData    Json?
  toolsUsed     Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  user          User              @relation(fields: [userId], references: [id])
  messages      ResearchMessage[]
  tasks         CrossAppTask[]    @relation("ResearchTasks")
}

model ResearchMessage {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String          @db.ObjectId
  role      String
  content   String
  metadata  Json?
  createdAt DateTime        @default(now())
  session   ResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model IdeaCritique {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  userId        String          @db.ObjectId
  title         String          @default("New Idea")
  status        String          @default("conversation")
  starred       Boolean         @default(false)
  ideaSummary   String?
  verdictData   Json?
  toolsUsed     Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id])
  messages      CriticMessage[]
}

model CriticMessage {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  critiqueId  String        @db.ObjectId
  role        String
  content     String
  metadata    Json?
  createdAt   DateTime      @default(now())
  critique    IdeaCritique  @relation(fields: [critiqueId], references: [id], onDelete: Cascade)
}

model TrendSession {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  title         String   @default("New Trend Search")
  query         String
  searchMode    String   @default("topic")
  platforms     String[]
  timeframe     String   @default("week")
  starred       Boolean  @default(false)
  trendResults  Json?
  analysis      Json?
  ideas         Json?
  calendar      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
}

model ContentSession {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  userId        String           @db.ObjectId
  title         String           @default("New Content")
  status        String           @default("conversation")
  starred       Boolean          @default(false)
  platforms     String[]
  goal          String?
  briefSummary  String?
  contentData   Json?
  calendarData  Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id])
  messages      ContentMessage[]
}

model ContentMessage {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  sessionId   String         @db.ObjectId
  role        String
  content     String
  metadata    Json?
  createdAt   DateTime       @default(now())
  session     ContentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model StrategistSession {
  id        String              @id @default(auto()) @map("_id") @db.ObjectId
  userId    String              @db.ObjectId
  title     String              @default("New Strategy Session")
  starred   Boolean             @default(false)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id])
  messages  StrategistMessage[]
}

model StrategistMessage {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String            @db.ObjectId
  role      String
  content   String
  metadata  Json?
  createdAt DateTime          @default(now())
  session   StrategistSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model CoachSession {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  userId    String          @db.ObjectId
  title     String          @default("New Coaching Session")
  persona   String          @default("auto")
  starred   Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id])
  messages  CoachMessage[]
}

model CoachMessage {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String       @db.ObjectId
  role      String
  content   String
  metadata  Json?
  createdAt DateTime     @default(now())
  session   CoachSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Folder {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  userId      String       @db.ObjectId
  name        String
  description String?
  color       String       @default("violet")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id])
  items       FolderItem[]
}

model FolderItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  folderId   String   @db.ObjectId
  itemType   String
  itemId     String
  itemTitle  String
  createdAt  DateTime @default(now())
  folder     Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
}

model CrossAppTask {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  sourceApp       String
  targetApp       String
  taskType        String
  status          String           @default("pending")
  payload         Json
  result          Json?
  sourceRefId     String?          @db.ObjectId
  targetRefId     String?          @db.ObjectId
  createdAt       DateTime         @default(now())
  completedAt     DateTime?
  researchSession ResearchSession? @relation("ResearchTasks", fields: [sourceRefId], references: [id])
}
