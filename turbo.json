{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "AUTH_USERNAME",
    "AUTH_PASSWORD",
    "ANTHROPIC_API_KEY",
    "OPENAI_API_KEY",
    "PERPLEXITY_API_KEY",
    "SERPER_API_KEY",
    "SERPAPI_API_KEY",
    "FIRECRAWL_API_KEY",
    "APIFY_API_KEY",
    "YOUTUBE_API_KEY",
    "NEXT_PUBLIC_PROMPT_STUDIO_URL",
    "NEXT_PUBLIC_RESEARCH_HUB_URL"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^db:generate"]
    },
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "outputs": [".next/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
  }
}
